(version 1)
(allow default)
(deny network*)
(deny process-fork)
(deny process-exec)
(allow process-exec (literal (param "LEAN_BIN")))
(deny file-read-data (subpath "/Users") (subpath "/Volumes")
  (subpath "/private/var/folders") (subpath "/private/tmp"))
(allow file-read-data (subpath (param "LEAN_HOME")) (subpath (param "ARM_LIB"))
  (subpath (param "WORK")))
(deny file-write*)
(allow file-write* (subpath (param "WORK")) (literal "/dev/null"))
